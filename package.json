{
  "name": "hero-never-wins",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:engine": "node --test src/engine.test.ts",
    "test:battle": "node --test \"src/battle/**/*.test.ts\"",
    "test:game": "node --test \"src/game/**/*.test.ts\"",
    "test:layout": "node --test \"src/layout/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "pixi.js": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.65.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "license": "UNLICENSED"
}
